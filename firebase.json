{
  "hosting": {
    "site": "craving-heaven-e2e94",
    "public": ".",
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "functions/**",
      "firestore.rules",
      "firestore-debug.log",
      "STAFF_DESK_SETUP.md",
      "start-local-emulators.cmd",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "runtime": "nodejs22",
    "predeploy": ["node functions/scripts/build-menu-catalog.js"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "host": "0.0.0.0", "port": 9400 },
    "firestore": { "host": "0.0.0.0", "port": 9401 },
    "functions": { "host": "0.0.0.0", "port": 9402 },
    "hosting": { "host": "0.0.0.0", "port": 9403 },
    "hub": { "host": "127.0.0.1", "port": 9405 },
    "logging": { "host": "127.0.0.1", "port": 9406 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 9404 },
    "singleProjectMode": true
  }
}
